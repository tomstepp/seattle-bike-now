# Copy to .env and fill in. Never commit .env.
# VITE_* values are bundled into the page. The site fetches TomTom traffic
# itself, so restrict this key to the site's domain in TomTom's dashboard.
VITE_TOMTOM_KEY=

# OpenRouteService (free: openrouteservice.org/dev/#/signup) for bike routes and
# place search. Also bundled into the page; the free quota is the only exposure.
VITE_ORS_KEY=
