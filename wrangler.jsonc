{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seattle-bike-now",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Every 10 minutes. TomTom budget: 93 tiles x 144 runs = ~13,400 of 50,000/day.
  "triggers": { "crons": ["*/10 * * * *"] },
  // id is filled in on first deploy (wrangler provisions the namespace).
  "kv_namespaces": [{ "binding": "TRAFFIC" }],
  "observability": { "enabled": true },
  // Uncomment once tomstepp.com is active on Cloudflare (docs/DEPLOY.md, step 5).
  // "routes": [{ "pattern": "bike.tomstepp.com", "custom_domain": true }]
}
